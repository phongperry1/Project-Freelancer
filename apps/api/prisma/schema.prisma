generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthTokenType {
  REFRESH_TOKEN
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentType {
  QUIZ
  TEST
  EXAM
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  TEXT
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum NotificationType {
  SYSTEM
  COURSE
  ASSESSMENT
  COMMENT
  PROGRESS
}

// ============================================================
// 1. USER
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @db.VarChar(255)
  fullName     String     @db.VarChar(150)
  avatarUrl    String?    @db.VarChar(500)
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  authTokens            AuthToken[]
  taughtCourses         Course[]
  enrollments           CourseEnrollment[]
  lessonProgresses      LessonProgress[]
  lessonNotes           LessonNote[]
  assessmentSubmissions AssessmentSubmission[]
  comments              Comment[]
  notifications         Notification[]
  aiHistories           AiHistory[]

  @@index([role])
  @@index([status])
}

// ============================================================
// 2. AUTH TOKEN
// ============================================================

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  tokenHash String        @unique @db.VarChar(255)
  type      AuthTokenType
  expiresAt DateTime      @db.Timestamptz(6)
  revokedAt DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

// ============================================================
// 3. COURSE
// ============================================================

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  teacherId    String       @db.Uuid
  title        String       @db.VarChar(255)
  description  String?      @db.Text
  thumbnailUrl String?      @db.VarChar(500)
  status       CourseStatus @default(DRAFT)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  teacher     User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments CourseEnrollment[]
  chapters    Chapter[]

  @@index([teacherId])
  @@index([status])
}

// ============================================================
// 4. COURSE ENROLLMENT
// ============================================================

model CourseEnrollment {
  courseId        String    @db.Uuid
  studentId       String    @db.Uuid
  enrolledAt      DateTime  @default(now()) @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)
  progressPercent Int       @default(0)

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
  @@index([studentId])
}

// ============================================================
// 5. CHAPTER
// ============================================================

model Chapter {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @db.Uuid
  title     String @db.VarChar(255)
  sortOrder Int

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
}

// ============================================================
// 6. LESSON
// ============================================================

model Lesson {
  id        String       @id @default(uuid()) @db.Uuid
  chapterId String       @db.Uuid
  title     String       @db.VarChar(255)
  content   String?      @db.Text
  videoUrl  String?      @db.VarChar(500)
  sortOrder Int
  status    LessonStatus @default(DRAFT)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progresses  LessonProgress[]
  notes       LessonNote[]
  assessments Assessment[]
  comments    Comment[]
  aiHistories AiHistory[]

  @@unique([chapterId, sortOrder])
  @@index([chapterId])
  @@index([status])
}

// ============================================================
// 7. LESSON PROGRESS
// ============================================================

model LessonProgress {
  studentId       String    @db.Uuid
  lessonId        String    @db.Uuid
  progressPercent Int       @default(0)
  lastPosition    Int       @default(0)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime? @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([studentId, lessonId])
  @@index([lessonId])
}

// ============================================================
// 8. LESSON NOTE
// ============================================================

model LessonNote {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  lessonId  String @db.Uuid
  content   String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
}

// ============================================================
// 9. ASSESSMENT
// ============================================================

model Assessment {
  id              String         @id @default(uuid()) @db.Uuid
  lessonId        String         @db.Uuid
  title           String         @db.VarChar(255)
  type            AssessmentType
  durationMinutes Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions AssessmentSubmission[]

  @@index([lessonId])
  @@index([type])
}

// ============================================================
// 10. QUESTION
// ============================================================

model Question {
  id              String       @id @default(uuid()) @db.Uuid
  assessmentId    String       @db.Uuid
  content         String       @db.Text
  type            QuestionType
  score           Int          @default(1)
  sortOrder       Int
  solutionText    String?      @db.Text
  solutionFileUrl String?      @db.VarChar(500)

  assessment        Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options           QuestionOption[]
  submissionAnswers SubmissionAnswer[]

  @@unique([assessmentId, sortOrder])
  @@index([assessmentId])
}

// ============================================================
// 11. QUESTION OPTION
// ============================================================

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  sortOrder  Int

  question          Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submissionAnswers SubmissionAnswer[]

  @@unique([questionId, sortOrder])
  @@index([questionId])
}

// ============================================================
// 12. ASSESSMENT SUBMISSION
// ============================================================

model AssessmentSubmission {
  id            String    @id @default(uuid()) @db.Uuid
  assessmentId  String    @db.Uuid
  studentId     String    @db.Uuid
  attemptNumber Int
  score         Float?
  submittedAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    SubmissionAnswer[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([assessmentId])
  @@index([studentId])
  @@index([studentId, assessmentId])
}

// ============================================================
// 13. SUBMISSION ANSWER
// ============================================================

model SubmissionAnswer {
  id               String  @id @default(uuid()) @db.Uuid
  submissionId     String  @db.Uuid
  questionId       String  @db.Uuid
  selectedOptionId String? @db.Uuid
  answerText       String? @db.Text
  score            Float?

  submission     AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question       Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption?      @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
  @@index([selectedOptionId])
}

// ============================================================
// 14. COMMENT
// ============================================================

model Comment {
  id       String        @id @default(uuid()) @db.Uuid
  lessonId String        @db.Uuid
  userId   String        @db.Uuid
  parentId String?       @db.Uuid
  content  String        @db.Text
  status   CommentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lesson  Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([lessonId])
  @@index([userId])
  @@index([parentId])
}

// ============================================================
// 15. NOTIFICATION
// ============================================================

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @db.Uuid
  type    NotificationType
  content String           @db.Text
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================
// 16. AI HISTORY
// ============================================================

model AiHistory {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  lessonId  String? @db.Uuid
  question  String  @db.Text
  answer    String  @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([lessonId])
  @@index([studentId, createdAt])
}
